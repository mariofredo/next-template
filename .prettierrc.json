{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 160,
  "importOrder": [
    "^react$",
    "^next(.*)$",
    "^@/components/(.*)$",
    "^@/context/(.*)$",
    "^@/lib/(.*)$",
    "^@/const/(.*)$",
    "^@/public/(.*)$",
    "<THIRD_PARTY_MODULES>"
  ],
  "importOrderSortSpecifiers": true
}
